{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentic Work OS",
  "version": "0.1.0",
  "identifier": "dev.awos.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run prebuild"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../packages/core/dist-bundle/": "core/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDQTFEOEFCQTg4NEJBMkIKUldRcnVvU29xOWloUEthNGJacHI0NzZiT1pJY3lySmJWTjZWMm9hT2NscEoyTlp0Y1pjMDZGbnYK",
      "endpoints": [
        "https://github.com/sockulags/agentic-work-os/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
